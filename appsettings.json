{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Settings": {
    "BidChannelName": "bid-channel",
    "LogChannelName": "bot-logs",
    "AwardChannelName": "bid-bot-completed-auctions",
    "ShouldLogToChannel": true,
    "MessagePrefix": "!bb",
    "LootQueueChannelName": "",
    "DefaultAuctionDuration": 5,
    "QueuedAuctionSpacingSeconds": 30,
    "PaymentReminderMinutes": 45,
    "PaymentReminderChannelName": ""
  },
  "Data": {
    "ItemListPath": "Data/itemlist.txt",
    "ItemHtmlPath": "Data/ItemHtml.json",
    "DataFilePath": "Data",
    "AuctionHistoryPath": "Data/AuctionHistory.json"
  },
  "Discord": {
    "Token": "YourDiscordTokenHere"
  },
  "Voice": {
    "IsEnabled": true,
    "VoiceChannelName": "YourVoiceChannelNameHere",
    "SpeechKey": "YourAzureSpeechKeyHere",
    "SpeechRegion": "YourAzureSpeechRegionHere",
    "AnnouncementTemplate": "Bidding is now open for {ItemName}",
    "SpeakingRate": "0%",
    "Volume": 1.0,
    "IdleLeaveSeconds": 5,
    "StayConnectedDuringRaid": true,
    "MaxRaidHours": 6,
    "ConnectTimeoutSeconds": 30,
    "DebugLogging": true,
    "MaxQueueSize": 25,
    "CachePath": "Data/VoiceCache",
    "LocaleFilter": "en-",
    "AllowedVoices": [
      "en-GB-LibbyNeural",
      "en-GB-RyanNeural",
      "en-IE-EmilyNeural",
      "en-IE-ConnorNeural",
      "en-CA-ClaraNeural",
      "en-AU-NatashaNeural",
      "en-US-AriaNeural",
      "en-AU-WilliamNeural",
      "en-GB-MiaNeural",
      "en-US-JennyNeural",
      "en-CA-LiamNeural"
    ],
    "Pronunciations": {
    }
  },
  "EQLogParseSettings": {
    "ShouldParseLogFile": true,
    "EQLogFile": "FullPathIncludingExtensionToLogFileHere",
    "LogParseInterval": 10
  },
  "SheetSettings": {
    "CredentialFile": "data/service-account.json",
    "SheetName": "Raid Loot!",
    "WinnerColumn": "E",
    "AmountColumn": "F",
    "ItemNameColumn": "A",
    "HeldByColumn" : "B",
    "AuctionStartedColumn": "C",
    "PaidColumn": "G"
  }
}
