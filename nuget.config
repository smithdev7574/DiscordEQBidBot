<?xml version="1.0" encoding="utf-8"?>
<!--
  LocalPackages holds a patched Discord.Net (3.20.3-davefix.1) with the DAVE voice fix from
  https://github.com/discord-net/Discord.Net/pull/3288 applied on top of the official 3.20.2.
  When an official Discord.Net release newer than 3.20.2 is out, delete this file and the
  LocalPackages folder, and switch BidBot.csproj back to the official Discord.Net package.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="LocalPackages" value="LocalPackages" />
  </packageSources>
</configuration>
