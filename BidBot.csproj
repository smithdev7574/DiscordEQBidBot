<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-BidBot-cee2a72b-c7ec-4d6b-bd9a-081f827846d2</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Data\itemlist.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\itemlist.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include=".github\copilot-instructions.md" />
    <Content Update="Data\ItemHtml.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Data\service-account.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Patched Discord.Net with the DAVE voice fix, from LocalPackages (see nuget.config).
         Replace these three with <PackageReference Include="Discord.Net" Version="..." /> once an official release has the fix. -->
    <PackageReference Include="Discord.Net.WebSocket" Version="3.20.3-davefix.1" />
    <PackageReference Include="Discord.Net.Commands" Version="3.20.3-davefix.1" />
    <PackageReference Include="Discord.Net.Interactions" Version="3.20.3-davefix.1" />
    <PackageReference Include="DSharpPlus.Natives.Opus" Version="1.6.1.34" />
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.77.0.4290" />
    <PackageReference Include="libsodium" Version="1.0.22" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.53.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Items\Models\" />
  </ItemGroup>

  <!-- opus and libsodium come from NuGet. libdave is copied from the Natives folder when present. See README. -->
  <ItemGroup>
    <None Include="Natives\**\*.dll;Natives\**\*.so*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Licenses for redistributed native libraries, required by their ISC / BSD licenses. -->
  <ItemGroup>
    <None Include="ThirdPartyNotices\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" LinkBase="ThirdPartyNotices" />
  </ItemGroup>
</Project>
